<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.0.0</Version>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- The module ZIP ships the DLL without its PDB. A portable PDB leaves an absolute path in the DLL's debug record. -->
    <DebugType>None</DebugType>
  </PropertyGroup>
  <Target Name="CheckVrcftInstall" BeforeTargets="ResolveReferences" Condition="'$(VrcftInstallDir)' == ''">
    <Error Text="Pass -p:VrcftInstallDir=&lt;your Steam VRCFaceTracking folder&gt; when building the bridge." />
  </Target>
  <ItemGroup>
    <Compile Include="../shared/CheekTrackingSession.cs" Link="CheekTrackingSession.cs" />
    <Reference Include="VRCFaceTracking.Core">
      <HintPath>$(VrcftInstallDir)\VRCFaceTracking.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRCFaceTracking.SDK">
      <HintPath>$(VrcftInstallDir)\VRCFaceTracking.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(VrcftInstallDir)\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../shared/EyebrowPreference.cs" Link="EyebrowPreference.cs" />
    <Compile Include="../shared/CheekPuffCalibrationProfile.cs" Link="CheekPuffCalibrationProfile.cs" />
    <None Update="module.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <UsingTask TaskName="WriteQproModuleCard" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TemplateFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <ReleaseVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var versionPattern = new Regex(@"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$");
        if (!versionPattern.IsMatch(ReleaseVersion)) {
            Log.LogError("The module card version must be stable major.minor.patch.");
            return false;
        }
        var json = File.ReadAllText(TemplateFile);
        var field = new Regex("\"Version\"\\s*:\\s*\"[^\"]*\"");
        if (field.Matches(json).Count != 1) {
            Log.LogError("The module card template must have exactly one Version field.");
            return false;
        }
        File.WriteAllText(DestinationFile, field.Replace(json, "\"Version\": \"" + ReleaseVersion + "\""), new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="WriteModuleMetadata" AfterTargets="Build">
    <!-- The assembly, standalone card and Hub installer use the release version. -->
    <MakeDir Directories="$(OutputPath)" />
    <WriteQproModuleCard TemplateFile="$(MSBuildProjectDirectory)\module.json"
                         DestinationFile="$(OutputPath)module.json" ReleaseVersion="$(Version)" />
  </Target>
  <Target Name="PackageModule" AfterTargets="Build" DependsOnTargets="WriteModuleMetadata"
          Condition="'$(Configuration)' == 'Release' and '$(BuildModuleZip)' != 'false'">
    <PropertyGroup>
      <PackageFolder>$(OutputPath)package</PackageFolder>
      <PackageFile>$(OutputPath)Qpro.GazeBridge.zip</PackageFile>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageFolder)" />
    <MakeDir Directories="$(PackageFolder)" />
    <Copy SourceFiles="$(TargetPath);$(OutputPath)module.json" DestinationFolder="$(PackageFolder)" />
    <Delete Files="$(PackageFile)" />
    <ZipDirectory SourceDirectory="$(PackageFolder)" DestinationFile="$(PackageFile)" />
  </Target>
</Project>
