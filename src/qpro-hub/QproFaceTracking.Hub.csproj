<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QproFaceTracking.Hub</AssemblyName>
    <RootNamespace>QproFaceTracking.Hub</RootNamespace>
    <Title>Qpro Companion</Title>
    <AssemblyTitle>Qpro Companion</AssemblyTitle>
    <Product>Qpro Companion</Product>
    <Description>Qpro Companion</Description>
    <Version>3.1.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(QproRemoteClicker)' == 'true'">
    <DefineConstants>$(DefineConstants);QPRO_REMOTE_CLICKER</DefineConstants>
    <Title>Qpro Companion · Kilobyte Edition</Title>
    <AssemblyTitle>Qpro Companion · Kilobyte Edition</AssemblyTitle>
    <Product>Qpro Companion · Kilobyte Edition</Product>
    <Description>Qpro Companion · Kilobyte Edition</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(QproRemoteClicker)' != 'true'">
    <Compile Remove="RemoteClicker/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(QproRemoteClicker)' == 'true'">
    <EmbeddedResource Include="RemoteClicker/click.wav" LogicalName="Qpro.RemoteClicker.wav" />
    <EmbeddedResource Include="RemoteClicker/double-click.wav" LogicalName="Qpro.RemoteDoubleClick.wav" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../shared/CheekTrackingSession.cs" Link="CheekTrackingSession.cs" />
    <Compile Include="../shared/EyebrowPreference.cs" Link="EyebrowPreference.cs" />
    <Compile Include="../shared/CheekPuffCalibrationProfile.cs" Link="CheekPuffCalibrationProfile.cs" />
    <Compile Include="../shared/CheekPuffTelemetry.cs" Link="CheekPuffTelemetry.cs" />
    <Compile Include="../shared/DeveloperCheekPuffBaseline.cs" Link="DeveloperCheekPuffBaseline.cs" />
  </ItemGroup>
  <Import Project="DirectVrchat.sources.props" />
</Project>
