<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QproFaceTracking.Hub</AssemblyName>
    <RootNamespace>QproFaceTracking.Hub</RootNamespace>
    <Version>2.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/CheekTrackingSession.cs" Link="CheekTrackingSession.cs" />
    <Compile Include="../shared/EyebrowPreference.cs" Link="EyebrowPreference.cs" />
    <Compile Include="../shared/CheekPuffCalibrationProfile.cs" Link="CheekPuffCalibrationProfile.cs" />
    <Compile Include="../shared/CheekPuffTelemetry.cs" Link="CheekPuffTelemetry.cs" />
    <Compile Include="../shared/DeveloperCheekPuffBaseline.cs" Link="DeveloperCheekPuffBaseline.cs" />
  </ItemGroup>
</Project>
